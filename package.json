{
  "name": "ai-chronicle",
  "productName": "AI轨迹",
  "private": true,
  "version": "0.2.0",
  "description": "本地优先的 AI 工作统计、历史档案与日报桌面应用",
  "author": "AI Chronicle",
  "repository": {
    "type": "git",
    "url": "https://example.com/ai-chronicle.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icon": "node scripts/generate-icon.mjs",
    "pack": "npm run build && npm run icon && electron-builder --dir",
    "dist": "npm run build && npm run icon && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.aichronicle.desktop",
    "productName": "AI轨迹",
    "copyright": "Copyright © 2026 AI Chronicle",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "AI-Chronicle-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI轨迹",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "AI-Chronicle-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "liixnglinb",
        "repo": "AI-Chronicle",
        "releaseType": "release"
      }
    ]
  }
}
